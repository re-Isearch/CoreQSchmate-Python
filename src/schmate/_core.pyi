class Metric(enum.Enum):
    L1 = 0

    L2 = 1

    IP = 2

    COSINE = 3

class SearchMode(enum.Enum):
    KNN = 0

    RADIUS = 1

    RELATIVE = 2

    ADAPTIVE = 3

    EPSILON = 4

class Quantization(enum.Enum):
    NONE = 0

    BIN1 = 1

    INT158 = 2

    INT4 = 3

    INT8 = 4

    INT16 = 5

    FP16 = 6

    BF16 = 7

class QuantizationAlgorithm(enum.Enum):
    PASS = 0

    STANDARD = 1

    BETTER = 2

    CENTROID = 3

    ROTATIONAL = 4

    RABITQ = 5

    RABITQ_EXTENDED = 6

class StorageType(enum.Enum):
